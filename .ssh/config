# zeus and home are the same physical host; pick the block by network context.
# Per-host blocks below hold only what differs (Hostname/Port). SSH takes the
# first value for single-valued options, so these must precede the shared block.
Host zeus
	Hostname 172.18.18.31

Host home
    Hostname home.chad-cat-lore-eddie.com
    Port 2222

# Shared settings for both. The ssh-tunnel-proxy now owns port forwarding;
# see .local/bin/ssh-tunnel-proxy.
Host zeus home
    User chad
    IdentityFile ~/.ssh/zeus.pub

Host chadshost
	Hostname chadshost.xyz
	User ubuntu
	IdentityFile ~/.ssh/chadshost.2026-06-11.pub

Host spqr
	Hostname spqr.app
	User ubuntu
	IdentityFile ~/.ssh/spqr.pub

Host lore-pi
	Hostname 10.13.13.2
	User chad
	ProxyCommand docker exec -i netflix-vpn socat STDIO TCP:%h:%p
	PreferredAuthentications password

Host lore-pi-proxy
        Hostname 10.13.13.2
        User chad
        ProxyCommand ssh home "docker exec -i netflix-vpn socat STDIO TCP:%h:%p"
        PreferredAuthentications password

Host github.com
	User git
	IdentityFile ~/.ssh/zeus.pub
	IdentitiesOnly yes

Host codeberg.org
	User git
	IdentityFile ~/.ssh/zeus.pub
	IdentitiesOnly yes

Host *
	AddKeysToAgent yes
	XAuthLocation "~/.local/bin/xauth.sh"
	ForwardX11Trusted yes
	ControlMaster auto
	ControlPath ~/.ssh/ssh_mux_%h_%p_%r
	ControlPersist 900
	ForwardAgent yes

# Use the 1Password SSH agent only on macOS (its socket lives under
# ~/Library/Group Containers). On other OSes, fall back to the default
# agent (SSH_AUTH_SOCK / ssh-agent) rather than a nonexistent socket path.
Match exec "uname -s | grep -q Darwin"
	IdentityAgent "~/.1password/agent.sock"

