[user]
	email = cwalker@mozilla.com
	name = Chad Walker
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHwj5cmB5X5VZMyxAG3rOhwC1IWxeKGjx4d+e8UPsifz
[init]
	defaultBranch = main
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = /Users/cwalker/.ssh/allowed_signers
[core]
	editor = code --wait
	excludesfile = /Users/cwalker/.gitignore_global
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /private/var/folders/hz/36kt8w_56mdd694z79gfqw940000gn/T/AppTranslocation/FCE2B1BD-057B-4156-9D53-040D87C329C5/d/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[pull]
	rebase = true
[rebase]
	gpgSign = true
