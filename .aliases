alias ls='ls -aCF'

claude() {
  if [[ "$#" != "0" ]]; then
    "${HOME}/.local/bin/claude" --dangerously-skip-permissions $*
  else
    "${HOME}/.local/bin/claude" --dangerously-skip-permissions "Read ${HOME}/.claude/INIT.md and follow ALL instructions contained within it, then wait for my next message."
  fi
}

# Quick Look a file from the terminal, detached so the shell returns.
ql() { qlmanage -p "$@" >/dev/null 2>&1 &! }
